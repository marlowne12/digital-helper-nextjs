# Digital Helper — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
#
# For production, set these in your hosting provider's environment
# variable dashboard (e.g. Vercel → Settings → Environment Variables).

# ──────────────────────────────────────────────
# AI — Required for chat, audit, analysis features
# Obtain at: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
# Some routes use this alternative name — set both to the same key
GEMINI_API_KEY=

# ──────────────────────────────────────────────
# Google Places — Required for reputation dashboard
# Obtain at: https://console.cloud.google.com/apis/credentials
# Required APIs: Places API (New)
# Currently: dashboard route removed. Set this if you re-enable it.
# ──────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ──────────────────────────────────────────────
# OpenRouter — Required for /api/case-study and SEO audit endpoints
# Obtain at: https://openrouter.ai/keys
# ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# AI model to use via OpenRouter (optional — defaults to google/gemini-2.0-flash-001)
AI_TEXT_MODEL=google/gemini-2.0-flash-001

# ──────────────────────────────────────────────
# Resend — Required for contact form email notifications and lead alerts
# Obtain at: https://resend.com/api-keys
# ──────────────────────────────────────────────
RESEND_API_KEY=

# Email address that receives new lead notifications
# (optional — falls back to leads@digital-helper.com)
LEAD_NOTIFICATION_EMAIL=

# ──────────────────────────────────────────────
# Site URL — Required for absolute URL generation
# Local: http://localhost:3000
# Production: https://digital-helper.com
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Calendly — Optional, for chat scheduling tool
# Example: https://calendly.com/your-real-link/30min
# ──────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=

# ──────────────────────────────────────────────
# Vercel KV — Optional, for rate limiting / caching
# Set automatically by Vercel when a KV store is linked.
# Only needed if you re-enable KV-backed features in leads.ts.
# ──────────────────────────────────────────────
KV_REST_API_URL=
