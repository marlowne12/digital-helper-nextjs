# Digital Helper — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
#
# For production, set these in your hosting provider's environment
# variable dashboard (e.g. Vercel → Settings → Environment Variables).

# ──────────────────────────────────────────────
# AI — Required for chat, audit, analysis features
# Obtain at: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
# Some routes use this alternative name — set both to the same key
GEMINI_API_KEY=

# ──────────────────────────────────────────────
# Google Places — Required for reputation dashboard
# Obtain at: https://console.cloud.google.com/apis/credentials
# Required APIs: Places API (New)
# Currently: dashboard route removed. Set this if you re-enable it.
# ──────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ──────────────────────────────────────────────
# OpenRouter — Required for /api/case-study and SEO audit endpoints
# Obtain at: https://openrouter.ai/keys
# ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# AI model to use via OpenRouter (optional — defaults to google/gemini-2.0-flash-001)
AI_TEXT_MODEL=google/gemini-2.0-flash-001

# ──────────────────────────────────────────────
# Resend — Required for contact form email notifications and lead alerts
# Obtain at: https://resend.com/api-keys
# ──────────────────────────────────────────────
RESEND_API_KEY=

# Email address that receives new lead notifications
# (optional — falls back to business@digital-helper.com)
LEAD_NOTIFICATION_EMAIL=

# Sender address for lead notification emails.
# Must be on a Resend-verified domain (e.g. no-reply@digital-helper.com).
# Defaults to onboarding@resend.dev if blank (Resend shared domain — dev/testing only).
# Verify digital-helper.com at: https://resend.com/domains
RESEND_FROM_EMAIL=

# ──────────────────────────────────────────────
# Site URL — Required for absolute URL generation
# Local: http://localhost:3000
# Production: https://digital-helper.com
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Calendly — Optional, for chat scheduling tool
# Example: https://calendly.com/your-real-link/30min
# ──────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=

# ──────────────────────────────────────────────
# Vercel KV (Redis) — Required for durable lead storage (P3-002)
# Create a KV database: Vercel Dashboard > Storage > Create KV Database
# Link it to this project — Vercel auto-injects these three vars.
# Run: npm install @vercel/kv
# ──────────────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ──────────────────────────────────────────────
# Upstash Redis — Required for AI endpoint rate limiting (P3-004)
# Option A: Create a free Redis DB at https://console.upstash.com/
# Option B: If Vercel KV is already set up, use the same Upstash instance —
#   copy the REST URL/Token from the Upstash console for your KV database.
# Run: npm install @upstash/ratelimit @upstash/redis
# ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────
# Notion CRM Integration
# Obtain API key at: https://www.notion.so/my-integrations
# ──────────────────────────────────────────────
NOTION_API_KEY=
NOTION_DATABASE_ID=8cf665ae45854e96b44d14a48b92c399
